# Copy to examples/compose.env. This file is configuration, not a secrets store.
OPENIQ_IMAGE=openiq:local
OPENIQ_BIND=127.0.0.1
OPENIQ_PORT=8765
DEBUG=0
HTTPS=1
TRUST_PROXY=1
ALLOWED_HOSTS=openiq.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://openiq.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://openiq.example.com/auth/discord/callback/
ENABLE_BACKEND_ADMIN=0

# Create this directory before starting Compose; it is mounted as /backups.
BACKUP_HOST_DIRECTORY=./backups
BACKUP_INTERVAL=14400
BACKUP_KEEP=7
BACKUP_TIMEOUT=120
