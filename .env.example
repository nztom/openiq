# Production template. Copy to .env and configure OAuth and your TLS host.
DEBUG=0
# Leave SECRET_KEY unset to use the generated persistent signing key.
# SECRET_KEY=
OPENIQ_PORT=8765
OPENIQ_BIND=127.0.0.1
# SQLite is the default. See docs/DATABASES.md for PostgreSQL setup.
DATABASE_BACKEND=sqlite
# Leave DATABASE_PATH unset to use the normal local/container data directory.
# DATABASE_NAME=
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_SSLMODE=prefer
ALLOW_LOCAL_LOGIN=0
SEED_DEMO=0
# DEMO_PASSWORD=  # Development only; set an explicit private password.
ENABLE_BACKEND_ADMIN=1
BACKEND_ADMIN_USERNAME=openiq-admin
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS=1
TRUST_PROXY=0
CSRF_TRUSTED_ORIGINS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR_HOST/auth/discord/callback/
DISCORD_BOT_TOKEN=
ENABLE_DISCORD_DELIVERY=0
# Set one sync mode. Guild sync is fast for staging; global sync is for normal use.
DISCORD_SYNC_GLOBAL=1
DISCORD_SYNC_GUILD=
# Scheduled backups run in the web container only when this directory is mounted.
# Mount an operator-controlled host directory at BACKUP_OUTPUT in a Compose override.
BACKUP_OUTPUT=/backups
BACKUP_INTERVAL=14400
BACKUP_KEEP=7
BACKUP_TIMEOUT=120

TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

OPENIQ_VERSION=development
# Set to scheduler,bot when those profiles are enabled.
REQUIRED_PROCESSES=

HSTS_SECONDS=3600
# Enable these only after verifying every subdomain supports HTTPS.
HSTS_INCLUDE_SUBDOMAINS=0
HSTS_PRELOAD=0

REQUEST_LIMITS_ENABLED=1
RATE_LIMIT_OAUTH=20
RATE_LIMIT_ADMIN_LOGIN=5
RATE_LIMIT_RECOVERY=5
RATE_LIMIT_OCR=10
RATE_LIMIT_MUTATION=240

SESSION_MAX_AGE=28800
